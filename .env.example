# Loren Bullard Content Planner — Meta / Instagram connection
# Copy this file to .env and fill in values from your Meta developer app.

PORT=8787
DATA_DIR=.data
DATABASE_URL=
AUTH_SECRET=

# Collaborative row storage (advanced, both default off — see README.md
# "Collaborative planner row storage" for the required shadow-migration and
# parity-review steps before turning either of these on). Requires a direct
# Postgres connection via DATABASE_URL/POSTGRES_URL(_NON_POOLING) above;
# Supabase REST credentials alone are not sufficient.
PLANNER_ROW_STORAGE_ENABLED=false
PLANNER_ROW_WRITES_ENABLED=false

# Shared password for the planner page. Keep this private.
PLANNER_PASSWORD=

# "Instagram API with Instagram Login" app credentials
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Must match the redirect URI entered in your Meta app exactly.
INSTAGRAM_REDIRECT_URI=http://localhost:8787/auth/instagram/callback

# Current API version can be changed here without editing code.
META_API_VERSION=v25.0

# Optional: if you already have a valid long-lived Instagram User access token,
# you can paste it here and skip the browser OAuth step.
INSTAGRAM_ACCESS_TOKEN=

# Canva Connect API for automatic working-draft previews.
# Create an integration at https://www.canva.com/developers/ and enable
# design:content:read plus design:meta:read in its Scopes settings.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:8787/auth/canva/callback
